{
  "name": "@gofin/e2e",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24",
    "npm": ">=11"
  },
  "scripts": {
    "stack:up": "cd .. && test -f .env || cp .env.example .env && docker compose up -d --build && docker compose exec -T auth-service /service seed-admin",
    "test": "npm run stack:up && playwright test",
    "test:headed": "npm run stack:up && playwright test --headed",
    "test:ui": "npm run stack:up && playwright test --ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^25.6.0",
    "dotenv": "^16.5.0",
    "typescript": "^6.0.3"
  }
}
