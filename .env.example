# =============================================================================
# GoFin Environment Variables
# Copy to .env and fill in values: cp .env.example .env
# =============================================================================

# --- Shared ---
JWT_SECRET=super-secret-key-change-me
LOG_LEVEL=info
ENVIRONMENT=development

# --- Auth Service ---
AUTH_DB_URL=postgres://gofin:gofin@localhost:5432/gofin?sslmode=disable&search_path=auth
BCRYPT_COST=10

# --- Cookie Domain (production only, enables subdomain access for Grafana) ---
# Set to .yourdomain.com in production. Leave empty for localhost development.
COOKIE_DOMAIN=

# --- Admin Seed ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@gofin.local
ADMIN_PASSWORD=Admin1234!

# --- Finance Service ---
FINANCE_DB_URL=postgres://gofin:gofin@localhost:5432/gofin?sslmode=disable&search_path=finance
EXPENSE_SERVICE_ADDR=expense-service:9082

# --- Expense Service ---
IMMUDB_ADDR=immudb:3322
IMMUDB_USERNAME=immudb
IMMUDB_PASSWORD=immudb

# --- API Gateway ---
AUTH_SERVICE_ADDR=auth-service:9081
AUTH_SERVICE_REST=http://auth-service:8081
EXPENSE_SERVICE_REST=http://expense-service:8082
FINANCE_SERVICE_REST=http://finance-service:8083
DATARIGHTS_SERVICE_REST=http://datarights-service:8084

# --- MFE (Shell) ---
API_GATEWAY_URL=http://api-gateway:8080
COOKIE_SECURE=false

# --- Grafana Auth Proxy ---
GRAFANA_URL=http://grafana:3000
APP_URL=http://localhost:3000

# --- Alertmanager ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# --- Cloudflare Tunnels (production only) ---
CF_APP_TUNNEL_ID=
CF_APP_HOSTNAME=usegofin.com
CF_GRAFANA_TUNNEL_ID=
CF_GRAFANA_HOSTNAME=grafana.usegofin.com

# --- Datarights Service ---
DATARIGHTS_DB_URL=postgres://gofin:gofin@localhost:5432/gofin?sslmode=disable&search_path=datarights
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=gofin <noreply@usegofin.com>
BRAND_TOKENS_PATH=/app/tokens/brand.json
