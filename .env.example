# =============================================================================
# GoFin Environment Variables
# Copy to .env and fill in values: cp .env.example .env
# =============================================================================

# --- Shared (interpolated by multiple services in docker-compose.yml) --------

# Secret key for JWT signing and verification
# Consumer: docker-compose → api-gateway, auth-service, expense-service,
#           finance-service, grafana-auth-proxy
JWT_SECRET=super-secret-key-change-me

# Application log level (debug, info, warn, error)
# Consumer: docker-compose → all services
LOG_LEVEL=info

# Runtime environment identifier (development, production)
# Consumer: docker-compose → all services
ENVIRONMENT=development

# --- Auth Service ------------------------------------------------------------

# bcrypt hashing cost (lower = faster, less secure; 12 recommended for prod)
# Consumer: docker-compose → auth-service
BCRYPT_COST=10

# Cookie domain for cross-subdomain auth (e.g., .usegofin.com in production)
# Leave empty for localhost development.
# Consumer: docker-compose → auth-service
COOKIE_DOMAIN=

# Initial admin account seed credentials
# Consumer: docker-compose → auth-service
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@gofin.local
ADMIN_PASSWORD=Admin1234!

# --- Expense Service ---------------------------------------------------------

# immudb credentials for audit log storage
# Consumer: docker-compose → expense-service
IMMUDB_USERNAME=immudb
IMMUDB_PASSWORD=immudb

# --- FX Service -------------------------------------------------------------

# Open Exchange Rates app ID for live currency conversion. Required in
# production: without it, cross-currency conversions fail with a provider auth
# error. Same-currency conversions work without it. Get one at
# https://openexchangerates.org/signup
# Consumer: docker-compose → fx-service
OPEN_EXCHANGE_RATES_APP_ID=

# Provider request timeout, retry count, and cache max age. Defaults shown.
# Consumer: docker-compose → fx-service
FX_PROVIDER_TIMEOUT=2s
FX_PROVIDER_RETRY_COUNT=2
FX_CACHE_MAX_AGE=1h

# --- Datarights Service ------------------------------------------------------

# Email sending toggle and configuration
# Consumer: docker-compose → datarights-service
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM="gofin <noreply@usegofin.com>"

# --- Monitoring --------------------------------------------------------------

# Grafana auth proxy: URL where the main app is served (for redirect after login)
# Consumer: docker-compose → grafana-auth-proxy
APP_URL=http://localhost:3000

# Discord webhook for Alertmanager notifications
# Consumer: docker-compose → alertmanager
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# --- Error Monitoring --------------------------------------------------------

# Sentry DSN for the Go backend (gofin-backend project). Leave empty to disable.
# Consumer: docker-compose → api-gateway, auth-service, expense-service,
#           finance-service, datarights-service
SENTRY_DSN_BACKEND=

# Sentry DSN for the frontend (gofin-frontend project). Leave empty to disable.
# Not a secret: a browser DSN is public by design.
# Consumer: docker-compose → mfe (build arg AND runtime env for SSR)
SENTRY_DSN_FRONTEND=

# Deploy identity for Sentry releases: the bare commit SHA, with no artifact
# prefix. Each consumer applies its own prefix exactly once, so this must stay
# bare. scripts/deploy.sh writes it into /opt/gofin/.env on every deploy, so it is
# normally unset locally and events then carry no release.
# Consumer: docker-compose → api-gateway, auth-service, expense-service,
#           finance-service, datarights-service, mfe
SENTRY_RELEASE=

# --- Cloudflare Tunnels (production only, used by deploy script) -------------

# App tunnel ID and public hostname
# Consumer: deploy script (envsubst) → config-app.yml
CF_APP_TUNNEL_ID=
CF_APP_HOSTNAME=usegofin.com

# Grafana tunnel ID and public hostname
# Consumer: deploy script (envsubst) → config-grafana.yml
CF_GRAFANA_TUNNEL_ID=
CF_GRAFANA_HOSTNAME=grafana.usegofin.com
