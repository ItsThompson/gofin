{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Login Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "gofin-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"auth-service\",path=\"/api/auth/login\",status=\"200\"}[5m]))",
          "legendFormat": "successful logins/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Registration Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "gofin-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"auth-service\",path=\"/api/auth/register\",status=\"201\"}[5m]))",
          "legendFormat": "registrations/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Token Refresh Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "gofin-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(token_refresh_total[5m])) by (status)",
          "legendFormat": "{{ status }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      }
    },
    {
      "title": "Failed Auth Attempts",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "gofin-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"auth-service\",path=\"/api/auth/login\",status=\"401\"}[5m]))",
          "legendFormat": "failed logins/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["gofin", "auth"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Auth Service",
  "uid": "gofin-auth-service"
}
